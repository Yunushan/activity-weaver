# Discord Developer Application ID used by the local bridge.
ACTIVITYWEAVER_DISCORD_CLIENT_ID=

# Optional local bridge settings.
ACTIVITYWEAVER_HOST=127.0.0.1
ACTIVITYWEAVER_PORT=32164
ACTIVITYWEAVER_LOG_LEVEL=info

# Optional authenticated mobile/remote bridge. Set all five values together.
# Use a trusted certificate and a randomly generated token of at least 32 chars.
# ACTIVITYWEAVER_REMOTE_HOST=0.0.0.0
# ACTIVITYWEAVER_REMOTE_PORT=32165
# ACTIVITYWEAVER_REMOTE_TOKEN=
# ACTIVITYWEAVER_REMOTE_TLS_CERT=/path/to/fullchain.pem
# ACTIVITYWEAVER_REMOTE_TLS_KEY=/path/to/private-key.pem
