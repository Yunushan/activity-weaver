{
  "name": "activityweaver",
  "version": "0.1.0",
  "private": true,
  "description": "A privacy-first, extensible browser activity bridge for Discord Rich Presence.",
  "license": "0BSD",
  "author": "ActivityWeaver contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yunushan/activity-weaver.git"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "pnpm -r build",
    "build:bridge": "pnpm --filter @activityweaver/bridge build",
    "build:extension": "pnpm --filter @activityweaver/extension build",
    "dev:bridge": "pnpm --filter @activityweaver/bridge dev",
    "lint": "pnpm -r lint",
    "package:bridge": "node tools/package-bridge.mjs",
    "package:extension": "node tools/package-extension.mjs",
    "package:firefox": "node tools/package-firefox.mjs",
    "package:firefox:android": "node tools/package-firefox-android.mjs",
    "package:safari": "node tools/package-safari.mjs",
    "security:audit": "pnpm audit --audit-level=high",
    "test": "pnpm -r test && pnpm test:unit",
    "test:unit": "node --test tests/bridge.test.mjs tests/catalog.test.mjs tests/content-contract.test.mjs tests/protocol.test.mjs",
    "test:e2e": "node --test tests/extension.e2e.test.mjs",
    "typecheck": "pnpm -r typecheck",
    "validate": "node tools/validate-activities.mjs",
    "check:artifacts": "node tools/check-release-artifacts.mjs",
    "check:ci": "node tools/check-ci-hardening.mjs",
    "check:production": "node tools/check-production-readiness.mjs",
    "check:browsers": "node tools/check-browser-compatibility.mjs",
    "check:platforms": "node tools/check-platform-support.mjs",
    "verify": "pnpm validate && pnpm build && pnpm lint && pnpm typecheck && pnpm test && pnpm security:audit && pnpm check:browsers && pnpm check:platforms && pnpm check:ci && pnpm check:production"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "typescript": "^7.0.2"
  }
}
